{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode gzip
    request_body {
        max_size 20MB
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /docs* {
        reverse_proxy backend:8000
    }

    handle /openapi.json {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
