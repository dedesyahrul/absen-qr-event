APP_ENV=production
POSTGRES_DB=absen_qr
POSTGRES_USER=absen
POSTGRES_PASSWORD=replace_with_a_long_random_password
JWT_SECRET=replace_with_another_long_random_secret
INITIAL_ADMIN_EMAIL=admin@your-domain.com
INITIAL_ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# The outer reverse proxy connects to this local-only port.
PUBLIC_BIND_IP=127.0.0.1
HTTPS_PORT=18443

CORS_ORIGINS=https://your-domain.com
